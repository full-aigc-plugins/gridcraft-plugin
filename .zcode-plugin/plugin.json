{
  "name": "gridcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "预算执行、两表对账、表格清洗、销售汇总与公式审计；保留数据单位与来源，公式可重算。",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "GridCraft（电子表格）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "gridcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "GridCraft（电子表格）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "GridCraft (Spreadsheets)",
          "zh-CN": "GridCraft（电子表格）"
        },
        "icon": "table",
        "server": "gridcraft-editor",
        "resourceUri": "ui://gridcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
